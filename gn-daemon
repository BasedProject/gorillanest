def validate_key(username, key):
    if username == 'git': return True
    if not GLOBAL_CONFIG['SCRIMSHAW']: return False

    try:
        database_uri  = Path(GLOBAL_CONFIG['DATABASE_LOCATION']).resolve().as_uri()
        database_uri += '?mode=ro'
        with closing(sqlite3.connect(database_uri, uri=True)) as database:
            database.execute('PRAGMA query_only = 1')
            user = database.execute(
                'SELECT ssh_public_key FROM users WHERE username = ?',
                (username,),
            ).fetchone()
        if user is None or not user[0]:
            return False
        return asyncssh.import_public_key(user[0]) == key
    except (sqlite3.Error, ValueError, OSError, TypeError):
        log.warning("Scrimshaw public-key authentication failed for user %r", username)
        return False

# Implementing AsyncSSH functionality is done primarily though polymorphism.
#  This is the class it expects.
#  Complete function definitions are moved out so that
#   this class doesn't dominate the script,
#   and its never in question what should and should not be inside it.
class GNServer(asyncssh.SSHServer):
    def begin_auth(self, username):
        log.info(f"Connection initiated by {username}")
        return username != 'git'
    def password_auth_supported(self):
        return False
    def public_key_auth_supported(self):
        return True
    def validate_public_key(self, username, key):
        return validate_key(username, key)
