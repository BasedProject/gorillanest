def connect_to_permission_cache():
    global permission_cache_db
    if permission_cache_db is not None:
        return permission_cache_db

    db_path = permission_cache_path
    uri = f"file:{db_path}?mode=ro"
    try:
        conn = sqlite3.connect(uri, uri=True, check_same_thread=False)
        conn.execute("PRAGMA query_only = 1")
    except sqlite3.OperationalError as e:
        log.error("Unable to open permission cache '%s': %s", db_path, e)
        raise

    permission_cache_db = conn
    return permission_cache_db

def get_writable_repositories(user: str) -> [str]:
    db = connect_to_permission_cache()
    cur = db.execute(
        "SELECT repo_key FROM permissions WHERE username = ? ORDER BY repo_key",
        (user,)
    )
    return [row[0] for row in cur.fetchall()]

def writable_repos_to_bwrap_bind_args(git_root: str, repo_keys: [str]) -> [str]:
    args = []
    for repo_key in repo_keys:
        host_path = os.path.join(git_root, repo_key)
        args += ["--bind", host_path, host_path]
    return args

def write_bwrap_args_file(args: [str]):
    # using "bwrap-args" is not a race condition
    fd = os.memfd_create("bwrap-args")
    data = b'\0'.join(a.encode() for a in args) + b'\0' if args else b''
    os.writev(fd, [data])
    os.lseek(fd, 0, os.SEEK_SET)
    return os.fdopen(fd, "rb")

def base_bwrap_sandbox_args(cwd: str) -> [str]:
    args = []
    args += ["--proc", "/proc"]
    args += ["--dev", "/dev"]
    args += ["--ro-bind", cwd, cwd]

    extras_system_paths = (
        # regular (gentoo/alpine) set
        "/bin/",
        "/usr/bin/",
        "/lib/",
        "/lib64/",
        "/usr/lib/",
        "/usr/lib64/",
        "/usr/libexec/",
        # esoteric set
        "/usr/local/bin/",
        "/lib32/",
        "/libexec/",
        "/usr/lib32/",
        "/usr/local/lib/",
        "/usr/local/lib32/",
        "/usr/local/lib64/",
        "/usr/local/libexec/",
        "/usr/share/",
        # NOTE:
        # /sbin/ and its variants are missing intentially.
        # This is purely a pre-emptive measure.
    )
    for system_path in extras_system_paths:
        if os.path.isdir(system_path):
            args += ["--ro-bind", system_path, system_path]

    return args

def bwrap_argv_for_user(user: str, program_argv: [str]) -> ([str], object):
    git_root = GLOBAL_CONFIG['GIT_ROOT']

    bind_args = []
    if user != 'git':
        bind_args = writable_repos_to_bwrap_bind_args(
            git_root, get_writable_repositories(user)
        )
    args_fd_file = write_bwrap_args_file(bind_args)

    user_path = os.path.realpath(os.path.join(git_root, user))


    user_bind_args = []
    if user != 'git' and os.path.isdir(user_path):
        user_bind_args = ["--bind", user_path, user_path]

    argv = [
        which("bwrap"),
        *base_bwrap_sandbox_args(os.getcwd()),
        "--ro-bind", git_root, git_root,
        *user_bind_args,
        "--args", str(args_fd_file.fileno()),
        "--",
        *program_argv,
    ]
    return argv, args_fd_file

def ensure_host_key(path: str) -> str:
    if os.path.exists(path): return path

    log.info("Generating ephemeral host key (saved to %s)", path)
    key = asyncssh.generate_private_key('ssh-rsa')
    with open(path, "wb") as f: f.write(key.export_private_key())
    os.chmod(path, 0o600)

    return path

def validate_privileged_client_process(cmd : str) -> [str]:
    argv = shlex.split(cmd)

    if '/' in argv[0]:
        log.warning(f"User tried funny business with '{argv[0]}'.")
        raise Exception("Stop fucking with my server!")

    argv[0] = "PATH/daemon/" + argv[0]

    return argv

def validate_guest_client_process(cmd : str) -> [str]:
    argv = shlex.split(cmd)
    if argv[0] != 'git-upload-pack':
        log.warning(f"Guest tried funny business with '{argv[0]}'.")
        raise Exception("Stop fucking with my server!")

    argv[0] = "PATH/daemon/git-upload-pack"

    return argv

def ssh_echo_exceptions(func):
    @functools.wraps(func)
    async def wrapper(proc: asyncssh.SSHServerProcess, *args, **kwargs):
        try: return await func(proc, *args, **kwargs)
        except Exception as e:
            log.warning(e)
            proc.stderr.write(f"error: {e}\n".encode())
            proc.exit(1)
        finally: proc.close()
    return wrapper

@ssh_echo_exceptions
async def gn_process(proc : asyncssh.SSHServerProcess):
    cmd = proc.command

    async def pump(reader, writer, label):
        while True:
            data = await reader.read(4096)
            if not data: break
            writer.write(data)
            await writer.drain()

    username = proc.get_extra_info('username')

    env = environ.copy()
    env['PATH']     = 'PATH/daemon/'
    env['USERNAME'] = username
    env['GIT_ROOT'] = GLOBAL_CONFIG['GIT_ROOT']

    if username == 'git':
        validate_client_process = validate_guest_client_process
    else:
        validate_client_process = validate_privileged_client_process

    argv, args_fd_file = bwrap_argv_for_user(
        username, validate_client_process(cmd)
    )

    #args_fd_file.seek(0)
    #log.info(f"Executing '{argv}'; Args-file is '{args_fd_file.read()}'")
    #args_fd_file.seek(0)

    sub = await asyncio.create_subprocess_exec(
        *argv,
        stdin=asyncio.subprocess.PIPE,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE,
        env=env,
        pass_fds=(args_fd_file.fileno(),)
    )

    await asyncio.gather(
        pump(proc.stdin, sub.stdin,   " >> "),
        pump(sub.stdout, proc.stdout, " << "),
        pump(sub.stderr, proc.stderr, " << ")
    )

    rc = await sub.wait()
    proc.exit(rc)

async def start_server():
    host_key_path = ensure_host_key(GLOBAL_CONFIG['HOST_KEY_PATH'])

    await asyncssh.create_server(
        GNServer,
        GLOBAL_CONFIG['LISTEN_ADDR'],
        GLOBAL_CONFIG['LISTEN_PORT'],
        server_host_keys=[host_key_path],
        process_factory=gn_process,
        encoding=None
    )

    await asyncio.Future()

def init():
    global GLOBAL_CONFIG

    config      = ConfigObj('config.default.ini')
    user_config = ConfigObj('config.ini')
    config.merge(user_config)

    config_dict = {}
    config_dict.update(config.get('core', {}).items())
    config_dict.update(config.get('ssh', {}).items())
    config_dict.update(config.get('scrimshaw', {}).items())
    
    for k, v in config_dict.items():
        if k in GLOBAL_CONFIG:
            GLOBAL_CONFIG[k] = v
        else:
            log.fatal(f"unknown config key used '{k}'")
            exit(1)

    # XXX not scalable, must be generalized
    if GLOBAL_CONFIG['SCRIMSHAW'] not in ('0', '1'):
        raise ValueError('[ssh]/SCRIMSHAW must be 0 or 1')
    GLOBAL_CONFIG['SCRIMSHAW'] = GLOBAL_CONFIG['SCRIMSHAW'] == '1'

    if GLOBAL_CONFIG['SCRIMSHAW'] and not GLOBAL_CONFIG['DATABASE_LOCATION']:
        raise ValueError('[scrimshaw]/DATABASE_LOCATION is required when Scrimshaw is enabled')

    log.info(GLOBAL_CONFIG)

if __name__ == "__main__":
    init()
    try: asyncio.run(start_server())
    except (OSError, asyncssh.Error) as exc:
        log.error("Error starting server: %s", exc)
