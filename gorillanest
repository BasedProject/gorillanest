#!/bin/sh
set -e

missing_programs=0
for program in carton bwrap git lighttpd; do
	if ! command -v "$program" >/dev/null 2>&1; then
		printf 'Error: required system program not found: %s\n' "$program" >&2
		missing_programs=1
	fi
done
if [ "$missing_programs" -ne 0 ]; then
	exit 1
fi

# Bin
export PATH=".:$PATH"
# Python
. venv/bin/activate
# Perl
export PERL5LIB=".:local/lib/perl5/:$PERL5LIB"
# Go
export PATH="gopath/bin/:$PATH"
# ---
gn-init
# ---
gn-check
# ---
hivemind --root $(realpath .) service/gorillanest.procfile
